# MySQL（远程库：与线上一致；复制为 .env 后填写，勿提交 .env）
# DB_HOST：服务器公网 IP，或 VPN/内网可访问的主机名
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

DB_DIALECT=mysql

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SaaS 单租户店铺上限（代码默认 20；库字段 tenants.max_shops）

# 可选：node db/init.js 一次性引导超管（须同时设置；密码至少 8 位；勿提交真实值）
# SEED_BOOTSTRAP_USERNAME=
# SEED_BOOTSTRAP_PASSWORD=

# 本地 Node API 监听端口（默认 3001）
PORT=3001

# 匿名 GMV 大屏按 MySQL shops 过滤时使用的租户 ID（默认 1 = default 租户）
# DASHBOARD_TENANT_ID=1

# 可选：SQLite 订单表路径（与正式缓存无关）
# DAPING_DB_PATH=/home/admin/daping-staging/backend/data/dashboard.db

# --- Dashboard warmup（Phase-5.1 代码内并发固定为 1，此变量仅文档保留）---
# DASHBOARD_CACHE_WARMUP_ENABLED=0
# DASHBOARD_CACHE_WARMUP_TENANTS=1
# DASHBOARD_CACHE_WARMUP_DELAY_MS=8000

# --- TikTok OAuth（授权 URL 须 HTTPS，与 Partner 后台 Redirect URL 逐字一致）---
# TIKTOK_APP_ID=
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_REDIRECT_URI=https://stag.cqchic-cq.top/api/tiktok/auth/callback
# staging：官方「复制授权链接」（GET /api/tiktok/auth 返回 JSON，不拼 v2 seller host）
# TIKTOK_SERVICE_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize?service_id=7643664278885811989
# service authorize 回调无 state 时，staging 兜底 tenant/user（仅建议 staging 使用）
# TIKTOK_DEFAULT_TENANT_ID=6
# TIKTOK_DEFAULT_USER_ID=27
# 可选：旧 Partner 链路用 redirect_url 查询参数名
# TIKTOK_OAUTH_REDIRECT_QUERY_NAME=redirect_uri
# TIKTOK_OAUTH_INCLUDE_REDIRECT_URL=1
# 授权 URL scope（逗号分隔；未设置时使用默认 seller.authorization.info,seller.order.info,seller.shop.info）
# TIKTOK_OAUTH_SCOPE=seller.authorization.info,seller.order.info,seller.shop.info
# TIKTOK_OAUTH_SCOPE_DISABLED=1

# --- exchange_rates 种子（node backend/scripts/seedExchangeRates.js）---
# SEED_RATE_USD_THB=36.5
# SEED_RATE_USD_MYR=4.72
# SEED_RATE_USD_PHP=56.2
# SEED_RATE_USD_VND=25400
# SEED_RATE_USD_SGD=1.34

# --- Phase-4.2 同步队列（详见 docs/env.md、docs/sync-phase42-pressure-test.md）---
# prod 上线必须：ENABLED=1、QUEUE_ONLY=1、CONCURRENCY=1（禁止 prod 使用 3）
# SYNC_WORKER_ENABLED=0
# SYNC_USE_QUEUE_ONLY=0
# SYNC_WORKER_CONCURRENCY=1
# SYNC_JOB_RETRY_ENABLED=1
# SYNC_LOCK_TIMEOUT_MS=600000
# SYNC_SCHEDULER_INTERVAL_MS=30000
